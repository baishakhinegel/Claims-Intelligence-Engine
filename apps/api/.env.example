# ---- Server --------------------------------------------------------------
PORT=3000
CORS_ORIGIN=http://localhost:5173

# ---- Database (matches docker-compose.yml; host port 5433) ---------------
DATABASE_URL=postgresql://claims:claims@localhost:5433/claims_engine?schema=public

# ---- LLM -----------------------------------------------------------------
# "openai" calls the OpenAI API. "mock" uses a deterministic, offline rule-based
# judge — handy for demos, CI and when no key is available.
# If LLM_PROVIDER is "openai" but OPENAI_API_KEY is empty, the API falls back to "mock".
LLM_PROVIDER=openai
OPENAI_API_KEY=
# Any chat model that supports Structured Outputs (json_schema). Change freely.
OPENAI_MODEL=gpt-4o-mini
# Leave empty for reasoning models that reject a temperature parameter.
OPENAI_TEMPERATURE=0
OPENAI_TIMEOUT_MS=30000

# ---- Governance ----------------------------------------------------------
# Below this confidence (0-1) an assessment is routed to a human evaluator.
REVIEW_CONFIDENCE_THRESHOLD=0.75
